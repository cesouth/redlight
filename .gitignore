# Generated deliverables from scripts/customer_report.py. These are outputs of
# a run against your own data, not source -- regenerate rather than commit:
#   python scripts/customer_report.py --network ... --points ... --out report.pdf
# Note this does NOT cover docs/figures/, which holds the tracked figures the
# methodology paper embeds.
report.html
report.pdf
report.pptx
figs/
review/

# Outputs the documentation's own examples write. tests/test_docs.py runs them
# in a scratch directory so these should never appear here, but a snippet run
# by hand from the repo root would otherwise leave them behind.
/speeds.geojson
/speeds.png
/trafficability_peak.geojson
/speed_map.png

